# Flight API mode
# Use mock mode for local development and automated tests.
VITE_FLIGHT_API_MODE=mock

# Frontend-safe proxy URL for real API mode.
# Do not put Amadeus API keys, API secrets, bearer tokens, or access tokens in VITE_ variables.
VITE_FLIGHT_API_PROXY_URL=/api/duffel-flights

# Preferred real API mode after Wave 11 provider replacement.
# Supported frontend values: mock, duffel, amadeus.
# Amadeus remains a legacy/reference path.
# VITE_FLIGHT_API_MODE=duffel

# Server-only Amadeus credentials for the backend/serverless proxy.
# These must be configured only in the serverless/backend environment.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# Optional. Defaults to the Amadeus test API.
AMADEUS_API_BASE_URL=https://test.api.amadeus.com

# Server-only Duffel credentials for the future Duffel backend/serverless proxy.
DUFFEL_ACCESS_TOKEN=
DUFFEL_API_BASE_URL=https://api.duffel.com
